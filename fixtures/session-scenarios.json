      {
        "op": "tick",
        "mono": 5000,
        "wall": 1005000
      },
      {
        "op": "pause",
        "mono": 5000,
        "wall": 1005000
      },
      {
        "op": "tick",
        "mono": 25000,
        "wall": 1025000
      },
      {
        "op": "resume",
        "mono": 25000,
        "wall": 1025000
      },
      {
        "op": "tick",
        "mono": 28000,
        "wall": 1028000
      }
    ],
    "expected": {
      "phase": "focus",
      "remainingMs": 52000,
      "focusElapsedMs": 8000,
      "interrupted": false
    }
  },
