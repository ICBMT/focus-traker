{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the bundled main window can control sessions, local workspace data, and explicitly requested loopback AI. No shell, global input, OS lock, or general network commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "allow-runtime-info",
    "allow-load-workspace",
    "allow-save-workspace",
    "allow-export-workspace",
    "allow-session-snapshot",
    "allow-reset-session",
    "allow-start-session",
    "allow-pause-session",
    "allow-resume-session",
    "allow-finish-session",
    "allow-start-break",
    "allow-restore-session",
    "allow-compare-rhythm",
    "allow-ollama-models",
    "allow-ollama-chat",
    "allow-cancel-chat",
    "allow-companion-configure",
    "allow-companion-install-gnome",
    "allow-companion-status",
    "allow-companion-action",
    "allow-companion-expand",
    "allow-model-capabilities",
    "allow-screen-start",
    "allow-screen-stop",
    "allow-screen-status",
    "allow-screen-analyze"
  ]
}
